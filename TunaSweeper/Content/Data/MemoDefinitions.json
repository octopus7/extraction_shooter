[
  {
    "memo_id": 1,
    "title": "\ub0c9\uac01\uc2e4 \ubc14\ub2e5\uc758 \ud760",
    "body": "\ubc14\ub2e5\uc758 \ubb3c\uae30\ub294 \ub298 \ubd81\ucabd \ubc30\uc218\uad6c\ub85c \ud750\ub978\ub2e4. \ubb3c\uae38\uc774 \ub04a\uae34 \uacf3\uc740 \ub204\uad70\uac00 \ub9c9\uc544 \ub454 \uae38\uc774\ub2e4. \uc18c\ub9ac\uac00 \uba4e\uc740 \ub4a4\uc5d0\uc57c \uae08\uc18d\ud310 \uc544\ub798\uc5d0\uc11c \uc791\uc740 \uc9c4\ub3d9\uc774 \uc62c\ub77c\uc628\ub2e4."
  },
  {
    "memo_id": 2,
    "title": "\ud478\ub978 \uc0c1\uc790\uc758 \uaddc\uce59",
    "body": "\ud478\ub978 \ud45c\uc2dd\uc774 \ubd99\uc740 \uc0c1\uc790\ub294 \ub208\uc5d0 \uc798 \ub744\uc9c0\ub9cc \ubc18\ub4dc\uc2dc \uc548\uc804\ud55c \uac83\uc740 \uc544\ub2c8\ub2e4. \uc5f4\uae30 \uc804\uc5d0 \uc8fc\ubcc0\uc744 \ud55c \ubc14\ud034 \ub3c4\ub294 \uc2b5\uad00\uc744 \ub4e4\uc5ec\ub77c. \uae30\uacc4\uc74c\uc774 \uac00\uae4c\uc6b0\uba74 \uc190\uc744 \ub2a6\ucd94\ub294 \ud3b8\uc774 \ub0ab\ub2e4."
  },
  {
    "memo_id": 3,
    "title": "\ud0c4 \ub0c4\uc0c8\uac00 \ub0a8\uc740 \ubb38",
    "body": "\uadf8\uc744\ub9b0 \ubb38\ud2c0\uc740 \ud3ed\ubc1c\ubcf4\ub2e4 \uc624\ub798 \ub0a8\ub294\ub2e4. \uac19\uc740 \uc790\ub9ac\uc5d0 \uac80\uc740 \uc7ac\uac00 \ubc18\ubcf5\ud574\uc11c \uc313\uc774\uba74 \uadf8 \ub4a4\uc5d0\ub294 \uc804\ub825\uc120\uc774 \uc9c0\ub098\uac04\ub2e4. \uc816\uc740 \uc190\uc73c\ub85c \ub9cc\uc9c0\uc9c0 \ub9d0 \uac83."
  },
  {
    "memo_id": 4,
    "title": "\ube44\uc0c1\ub4f1 \uc138 \ubc88",
    "body": "\ubd89\uc740 \ube44\uc0c1\ub4f1\uc774 \uc138 \ubc88 \ub04a\uaca8 \uae5c\ubc15\uc774\uba74 \uadf8 \uad6c\uc5ed\uc758 \uac10\uc2dc \ub8e8\ud2f4\uc774 \ubc14\ub010\ub2e4. \ub450 \ubc88\uc774 \uc544\ub2c8\ub2e4. \uc138 \ubc88\uc9f8 \uc810\uba78 \ub4a4\uc5d0\ub294 \uc9e7\uc740 \ube48\ud2c8\uc774 \uc0dd\uae34\ub2e4."
  },
  {
    "memo_id": 5,
    "title": "\ubb3c\ud1b5\uc758 \ubb34\uac8c",
    "body": "\uac08\uc99d\uc740 \uccb4\ub825\ubcf4\ub2e4 \uba3c\uc800 \ud310\ub2e8\uc744 \ud750\ub9b0\ub2e4. \ubb3c\ud1b5 \ud558\ub098\ub97c \uc544\ub07c\ub824\ub2e4 \ud0c4\uc57d \ub450 \ubb36\uc74c\uc744 \ubc84\ub9ac\ub294 \uc77c\uc774 \uc0dd\uae34\ub2e4. \ubb34\uac8c\ub97c \uacc4\uc0b0\ud560 \ub54c \ubb3c\uc740 \ubcf4\ud5d8\uc73c\ub85c \uc138\uc5b4\ub77c."
  },
  {
    "memo_id": 6,
    "title": "\ub179\uc2a8 \uc0ac\ub2e4\ub9ac",
    "body": "\uc0ac\ub2e4\ub9ac\uc758 \uccab \uce78\uc774 \ucc28\uac11\uc9c0 \uc54a\uc73c\uba74 \ucd5c\uadfc\uc5d0 \ub204\uad70\uac00 \uc9c0\ub098\uac14\ub2e4. \uc190\uc7a1\uc774\uc5d0 \ub0a8\uc740 \uc628\uae30\ub294 \uac70\uc9d3\ub9d0\uc744 \ud558\uc9c0 \uc54a\ub294\ub2e4. \ub530\ub77c\uac08\uc9c0 \uc228\uc744\uc9c0\ub294 \ubc1c\uc18c\ub9ac\ub97c \ub4e3\uace0 \uc815\ud55c\ub2e4."
  },
  {
    "memo_id": 7,
    "title": "\ud30c\ub780 \ub80c\uc988",
    "body": "\ud478\ub978 \ub80c\uc988\ub97c \ub2e8 \uae30\uacc4\ub294 \uc815\uba74\ubcf4\ub2e4 \uce21\uba74\uc744 \ub2a6\uac8c \ubcf8\ub2e4. \ubc18\uc9dd\uc784\uc774 \uc67c\ucabd\uc73c\ub85c \ubc00\ub9ac\uba74 \uc774\ubbf8 \ucd94\uc801 \uc911\uc774\ub2e4. \ubcbd\uc744 \ub07c\uace0 \uc0ac\ub77c\uc9c0\ub294 \ud3b8\uc774 \ube60\ub974\ub2e4."
  },
  {
    "memo_id": 8,
    "title": "\uc2dd\ub7c9 \ucc3d\uace0\uc758 \ubc88\ud638",
    "body": "\ucc3d\uace0 \ubc88\ud638\uac00 \ub0ae\ub2e4\uace0 \ub354 \uc548\uc804\ud558\uc9c0 \uc54a\ub2e4. \uc624\ub798\ub41c \uad6c\uc5ed\uc77c\uc218\ub85d \uc7a0\uae08\uc740 \uc57d\ud558\uc9c0\ub9cc \ubc14\ub2e5\uc774 \uae30\uc5b5\ud558\ub294 \uc18c\ub9ac\ub294 \ub354 \ub9ce\ub2e4. \ube48 \uce94\uc740 \ubc1f\uc9c0 \ub9c8\ub77c."
  },
  {
    "memo_id": 9,
    "title": "\uce68\ubb35\ud558\ub294 \ubb34\uc804",
    "body": "\ubb34\uc804\uae30\uac00 \uc7a1\uc74c\uc744 \uc0bc\ud0a4\ub294 \uc21c\uac04\uc774 \uc788\ub2e4. \uadf8\ub54c\ub294 \uba40\ub9ac\uc11c \uc2e0\ud638\uac00 \uc628 \uac83\uc774 \uc544\ub2c8\ub77c \uac00\uae4c\uc6b4 \uacf3\uc5d0\uc11c \uc2e0\ud638\uac00 \ub20c\ub9b0 \uac83\uc774\ub2e4. \uae08\uc18d \uc120\ubc18 \uc544\ub798\ub97c \ud655\uc778\ud558\ub77c."
  },
  {
    "memo_id": 10,
    "title": "\uae34 \ubcf5\ub3c4\uc758 \ubc14\ub78c",
    "body": "\ubc14\ub78c\uc774 \ubcf5\ub3c4 \ub05d\uc5d0\uc11c \ubd88\uc5b4\uc624\uba74 \ucd9c\uad6c\uac00 \uc544\ub2c8\ub2e4. \ud658\uae30 \uc7a5\uce58\uac00 \uc0b4\uc544 \uc788\ub2e4\ub294 \ub73b\uc774\ub2e4. \ud32c \uc18c\ub9ac \uc0ac\uc774\uc5d0 \ud55c \ubc15\uc790 \ube60\uc9c0\ub294 \uad6c\uac04\uc774 \uc788\uc73c\uba74 \ud1b5\ub85c\uac00 \uc228\uaca8\uc838 \uc788\ub2e4."
  },
  {
    "memo_id": 11,
    "title": "\ub0a1\uc740 \ud0c4\ud53c",
    "body": "\ubc14\ub2e5\uc758 \ud0c4\ud53c\ub294 \ud56d\uc0c1 \uc804\ud22c\uc758 \ubc29\ud5a5\uc744 \ub9d0\ud55c\ub2e4. \uc785\uad6c \ucabd\uc73c\ub85c \uad74\ub7ec\uac04 \ud0c4\ud53c\uac00 \ub9ce\uc73c\uba74 \ub204\uad70\uac00 \ubb3c\ub7ec\ub098\uba70 \uc408\ub2e4. \uadf8 \ub05d\uc5d0\ub294 \ub300\uac1c \uae09\ud55c \uc228\uc774 \ub0a8\uc544 \uc788\ub2e4."
  },
  {
    "memo_id": 12,
    "title": "\uc7a0\uae34 \uc758\ub8cc\ud568",
    "body": "\uc758\ub8cc\ud568\uc774 \ube44\uc5b4 \uc788\uc5b4\ub3c4 \ubc84\ub9ac\uc9c0 \ub9c8\ub77c. \uc7a0\uae08\uc1e0 \uc548\ucabd\uc5d0\ub294 \uc587\uc740 \ucca0\uc2ec\uc774 \ub0a8\ub294\ub2e4. \uae09\ud560 \ub54c\ub294 \ubb38\ubcf4\ub2e4 \uc791\uc740 \ud2c8\uc774 \ub354 \uc4f8\ubaa8 \uc788\ub2e4."
  },
  {
    "memo_id": 13,
    "title": "\ud770 \uc120 \uc544\ub798",
    "body": "\ubc14\ub2e5\uc758 \ud770 \uc120\uc740 \uae38\uc7a1\uc774\uac00 \uc544\ub2c8\ub77c \uae08\uc9c0\uc120\uc774\uc5c8\ub2e4. \uc120\uc744 \ub530\ub77c\uac00\uba74 \ube60\ub974\uc9c0\ub9cc, \uc120 \uc544\ub798 \ubc30\uad00\uc740 \ubc1c\uc18c\ub9ac\ub97c \uba40\ub9ac \ubcf4\ub0b8\ub2e4. \uc870\uc6a9\ud788 \uac00\ub824\uba74 \uc120\uc744 \ube44\ucf1c\ub77c."
  },
  {
    "memo_id": 14,
    "title": "\ub3cc\uc544\uc624\uc9c0 \uc54a\uc740 \uc9c0\ub3c4",
    "body": "\uc9c0\ub3c4\uc5d0\ub294 \ubd81\ucabd\uc774 \uc704\ub77c\uace0 \uc801\ud600 \uc788\uc9c0\ub9cc \uc774\uacf3\uc758 \ubd81\ucabd\uc740 \ub298 \ucd9c\uad6c\ub97c \ub73b\ud558\uc9c0 \uc54a\ub294\ub2e4. \ud587\ube5b\uc774 \ub4e4\uc5b4\uc624\ub294 \ucabd\uacfc \uad6c\uc870 \uc2e0\ud638\uac00 \uc624\ub294 \ucabd\uc740 \ub2e4\ub974\ub2e4."
  },
  {
    "memo_id": 15,
    "title": "\uc804\uc6d0 \uc2a4\uc704\uce58 \uc606 \uba54\ubaa8",
    "body": "\uaebc\uc9c4 \uc7a5\uce58\ub294 \uc8fd\uc740 \uc7a5\uce58\uac00 \uc544\ub2c8\ub2e4. \uc804\uc6d0\uc774 \uc5c6\ub294 \ubb3c\uac74\ub3c4 \ub9c8\uc9c0\ub9c9 \uba85\ub839\uc744 \uae30\uc5b5\ud55c\ub2e4. \uc190\ub300\uae30 \uc804\uc5d0 \ubb34\uc5c7\uc744 \uba48\ucd94\ub824 \ud588\ub294\uc9c0 \uc0dd\uac01\ud558\ub77c."
  },
  {
    "memo_id": 16,
    "title": "\uc791\uc740 \ub098\uc0ac \ub450 \uac1c",
    "body": "\uc791\uc740 \ub098\uc0ac\ub294 \ubc84\ub9ac\uae30 \uc27d\ub2e4. \uadf8\ub7ec\ub098 \uc774\uacf3\uc758 \ubb38\uc740 \ud070 \ubd80\ud488\ubcf4\ub2e4 \uc791\uc740 \uace0\uc815\ud540 \ud558\ub098\ub85c \ubc84\ud2f4\ub2e4. \uc8fc\uba38\ub2c8 \ud55c \uce78\uc740 \ub298 \uc0ac\uc18c\ud55c \uac83\ub4e4\uc5d0\uac8c \ub0a8\uaca8 \ub450\uc5b4\ub77c."
  },
  {
    "memo_id": 17,
    "title": "\uc6b8\ub9bc\uc774 \ub0ae\uc740 \ubc29",
    "body": "\uc6b8\ub9bc\uc774 \ub0ae\uc740 \ubc29\uc740 \ube44\uc5b4 \uc788\ub294 \ubc29\uc774 \uc544\ub2c8\ub2e4. \ucc9c\uc7a5 \uc704 \uacf5\uac04\uc774 \uc18c\ub9ac\ub97c \uba39\uace0 \uc788\ub2e4. \uadf8\ub9bc\uc790\uac00 \uc5c6\ub294\ub370\ub3c4 \uc18c\ub9ac\uac00 \ub0ae\ub2e4\uba74 \uc704\ub97c \uba3c\uc800 \ubd10\ub77c."
  },
  {
    "memo_id": 18,
    "title": "\uc816\uc740 \uc7a5\uac11",
    "body": "\uc816\uc740 \uc7a5\uac11\uc740 \ucd94\uc704\ub97c \ub9c9\uc9c0 \ubabb\ud558\uc9c0\ub9cc \uac10\uc804\uc744 \uc870\uae08 \ub2a6\ucd98\ub2e4. \uc644\uc804\ud55c \uc548\uc804\uc740 \uc544\ub2c8\ub2e4. \uc7a0\uae50\uc758 \uc9c0\uc5f0\uc744 \ud0c8\ucd9c \uc2dc\uac04\uc73c\ub85c \ubc14\uafc0 \uc218 \uc788\uc744 \ubfd0\uc774\ub2e4."
  },
  {
    "memo_id": 19,
    "title": "\ub2eb\ud78c \ub208 \ud45c\uc2dc",
    "body": "\ub2eb\ud78c \ub208 \ud45c\uc2dd\uc740 \uc740\uc2e0 \uad6c\uc5ed\uc774\ub77c\ub294 \ub73b\uc774 \uc544\ub2c8\uc5c8\ub2e4. \uac10\uc2dc\uc790\uac00 \ub208\uc744 \uac10\ub294 \uad6c\uc5ed\uc774\ub77c\ub294 \ub73b\uc774\ub2e4. \uc624\ub798 \uba38\ubb3c\uba74 \ub2e4\uc2dc \ub728\ub294 \uc21c\uac04\uc744 \ub9de\uac8c \ub41c\ub2e4."
  },
  {
    "memo_id": 20,
    "title": "\ub9c8\uc9c0\ub9c9 \uc2dd\uc0ac \uc804",
    "body": "\ub204\uad70\uac00\ub294 \uccab \uc2dd\uc0ac\ub97c \ub9c8\uc9c0\ub9c9\ucc98\ub7fc \uc900\ube44\ud588\ub2e4. \uc811\uc2dc\uc758 \ubc29\ud5a5\uc774 \ubaa8\ub450 \ubd81\ucabd\uc744 \ud5a5\ud558\uace0 \uc788\uc5c8\ub2e4. \uadf8\ub4e4\uc774 \uae30\ub2e4\ub9b0 \uac83\uc740 \uc0ac\ub78c\uc774\uc5c8\uc744\uae4c, \uc2e0\ud638\uc600\uc744\uae4c."
  }
]
