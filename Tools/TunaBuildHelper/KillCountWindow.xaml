<Window x:Class="TunaBuildHelper.KillCountWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource ui.helper_kills.title}" Width="430" SizeToContent="Height"
 ResizeMode="NoResize" Background="#171B22" Foreground="#DCE5F0" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="24">
  <TextBlock x:Name="TargetText" TextWrapping="Wrap" Foreground="#91A5BE"/>
  <Label Target="{Binding ElementName=CountBox}" Content="{DynamicResource ui.helper_kills.label}" Foreground="#DCE5F0" Padding="0" Margin="0,16,0,5"/>
  <TextBox x:Name="CountBox" FontSize="18" MaxLength="19" IsEnabled="False" TextChanged="InputChanged"/>
  <TextBlock x:Name="StatusText" Margin="0,8" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="SaveButton" Click="Save_Click" Content="{DynamicResource ui.quest_cheat.fix}" MinWidth="74" IsEnabled="False" IsDefault="True"/>
   <Button x:Name="CloseButton" Content="{DynamicResource ui.coop.close}" MinWidth="74" Margin="8,0,0,0" IsCancel="True"/>
  </StackPanel>
 </StackPanel>
</Window>
