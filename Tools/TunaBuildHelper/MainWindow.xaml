<Window x:Class="TunaBuildHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Tuna Helper"
        Width="520"
        Height="760"
        MinWidth="440"
        MinHeight="510"
        WindowStartupLocation="CenterScreen"
        Background="#171B22">
    <Window.Resources>
        <sys:String x:Key="BuildSteamDemoLabel">Steam Demo 빌드</sys:String>
        <sys:String x:Key="BuildSteamFullLabel">Steam Full 빌드</sys:String>
        <sys:String x:Key="BuildStoveDemoLabel">STOVE Demo 빌드</sys:String>
        <sys:String x:Key="BuildStoveFullLabel">STOVE Full 빌드</sys:String>
        <sys:String x:Key="PackageBuildTooltip">Shipping 패키지를 생성하고 콘솔 창을 유지합니다.</sys:String>
        <sys:String x:Key="PackageBuildStartedStatus">패키징을 시작했습니다. 콘솔 창에서 진행 상황을 확인하세요.</sys:String>
        <sys:String x:Key="KillBuildLabel">빌드·패키징 강제 종료</sys:String>
        <sys:String x:Key="KillBuildTooltip">대기 중이거나 실행 중인 TunaSweeper 빌드·패키징을 강제 종료합니다.</sys:String>
        <sys:String x:Key="KillBuildStartedStatus">빌드·패키징 종료를 요청했습니다.</sys:String>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#273140" />
            <Setter Property="BorderBrush" Value="#3C4C61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#344257" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6B88AC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E2632" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#202833" />
            <Setter Property="Foreground" Value="#DCE5F0" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DCE5F0" />
            <Setter Property="Background" Value="#202833" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="설정">
                <MenuItem x:Name="RunAtStartupMenuItem"
                          Header="Windows 시작 시 실행"
                          IsCheckable="True"
                          Click="RunAtStartupMenuItem_Click" />
                <MenuItem x:Name="RegisterStartMenuMenuItem"
                          Header="시작 메뉴에 등록"
                          IsCheckable="True"
                          Click="RegisterStartMenuMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Grid Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Tuna Helper"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#F4F7FB" />
                <TextBlock Margin="0,6,0,0"
                           Text="자주 쓰는 작업 경로와 Unreal 프로젝트를 빠르게 엽니다."
                           FontSize="13"
                           Foreground="#AEBBCD" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,22,0,18">
                <Button Margin="0,0,0,10"
                        Click="BuildAndRunButton_Click"
                        ToolTip="TunaSweeper를 빌드하고 실행합니다.">
                    프로젝트 빌드 및 실행
                </Button>
                <Button Margin="0,0,0,10"
                        Background="#5A2630"
                        BorderBrush="#82414D"
                        Click="KillBuildButton_Click"
                        Content="{DynamicResource KillBuildLabel}"
                        ToolTip="{DynamicResource KillBuildTooltip}" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Margin="0,0,5,0"
                            Click="BuildSteamDemoButton_Click"
                            Content="{DynamicResource BuildSteamDemoLabel}"
                            ToolTip="{DynamicResource PackageBuildTooltip}" />
                    <Button Grid.Column="1"
                            Margin="5,0,0,0"
                            Click="BuildSteamFullButton_Click"
                            Content="{DynamicResource BuildSteamFullLabel}"
                            ToolTip="{DynamicResource PackageBuildTooltip}" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Margin="0,0,5,0"
                            Click="BuildStoveDemoButton_Click"
                            Content="{DynamicResource BuildStoveDemoLabel}"
                            ToolTip="{DynamicResource PackageBuildTooltip}" />
                    <Button Grid.Column="1"
                            Margin="5,0,0,0"
                            Click="BuildStoveFullButton_Click"
                            Content="{DynamicResource BuildStoveFullLabel}"
                            ToolTip="{DynamicResource PackageBuildTooltip}" />
                </Grid>
                <Button Margin="0,0,0,10"
                        Background="#5A2630"
                        BorderBrush="#82414D"
                        Click="KillEditorButton_Click"
                        ToolTip="실행 중인 TunaSweeper Unreal Editor를 종료합니다.">
                    Unreal Editor 종료
                </Button>
                <Button Margin="0,0,0,10"
                        Click="OpenUnrealProjectButton_Click"
                        ToolTip="TunaSweeper.uproject를 Unreal Editor로 엽니다.">
                    Unreal 프로젝트 열기
                </Button>
                <Button Margin="0,0,0,10"
                        Click="OpenProjectFolderButton_Click"
                        ToolTip="TunaSweeper 프로젝트 폴더를 탐색기로 엽니다.">
                    Unreal 프로젝트 폴더 열기
                </Button>
                <Button Margin="0,0,0,10"
                        Click="OpenFfmpegFolderButton_Click"
                        ToolTip="D:\github\ffmpeg 폴더를 탐색기로 엽니다.">
                    FFmpeg 폴더 열기
                </Button>
                <Button Click="OpenDownloadsFolderButton_Click"
                        ToolTip="다운로드 폴더를 탐색기로 엽니다.">
                    다운로드 폴더 열기
                </Button>
            </StackPanel>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="2"
                       Foreground="#91A5BE"
                       FontSize="12"
                       Text="준비됨" />
        </Grid>
    </DockPanel>
</Window>
