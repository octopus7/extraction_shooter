<Window x:Class="TunaBuildHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Tuna Helper"
        Width="520"
        Height="760"
        MinWidth="440"
        MinHeight="510"
        WindowStartupLocation="CenterScreen"
        Background="#171B22">
    <Window.Resources>
        <sys:String x:Key="ReadyStatus">준비됨</sys:String>
        <sys:String x:Key="MainTabLabel">Main</sys:String>
        <sys:String x:Key="CheatTabLabel">Cheat</sys:String>
        <sys:String x:Key="TunaFillButton">진엔딩 테스트 · 참치 꽉 채우기…</sys:String>
        <sys:String x:Key="TunaTitle">진엔딩 테스트 · 참치 채우기</sys:String>
        <sys:String x:Key="TunaConfirm">대상: {0}&#10;현재 맵: {1}&#10;저장 슬롯: {2}&#10;&#10;레이드 창고의 기존 내용물을 모두 교체하여 참치를 10칸 × 10개 = 100개 채우고 현재 슬롯에 저장합니다.&#10;일반 인벤토리, 장비, 엔딩 플래그는 변경하지 않습니다.&#10;&#10;진행할까요?</sys:String>
        <sys:String x:Key="TunaReading">참치 채우기 · 선택한 게임의 맵과 슬롯을 확인하는 중입니다…</sys:String>
        <sys:String x:Key="TunaWorking">참치 채우기 · 게임의 저장 완료 응답을 기다리는 중입니다…</sys:String>
        <sys:String x:Key="TunaSuccess">레이드 창고를 참치 100개로 채우고 현재 슬롯에 저장했습니다.</sys:String>
        <sys:String x:Key="TunaDisabled">이동 치트를 활성화한 뒤 다시 시도하세요.</sys:String>
        <sys:String x:Key="TunaUnsupported">참치 채우기를 지원하지 않는 게임입니다. 최신 빌드로 실행해 주세요.</sys:String>
        <sys:String x:Key="TunaUnavailable">게임플레이 중인 맵과 저장 슬롯을 확인할 수 없습니다. 게임에 진입한 뒤 다시 시도하세요.</sys:String>
        <sys:String x:Key="TunaStale">게임의 맵 또는 슬롯이 변경되었습니다. 대상을 다시 확인해 주세요.</sys:String>
        <sys:String x:Key="TunaBusy">이 게임에서 다른 진행 상태 요청을 처리 중입니다. 잠시 뒤 다시 시도하세요.</sys:String>
        <sys:String x:Key="TunaTimeout">완료 응답을 받지 못했습니다. 게임에서 창고 상태를 확인해 주세요.</sys:String>
        <sys:String x:Key="TunaFailure">참치 채우기를 완료하지 못했습니다. 게임 상태를 확인해 주세요.</sys:String>
        <sys:String x:Key="TunaCanceled">참치 채우기 요청을 취소했습니다. 이미 처리된 요청은 되돌릴 수 없습니다.</sys:String>
        <sys:String x:Key="WorldProgressOpen">월드 진행 초기화…</sys:String>
        <sys:String x:Key="FolderTabLabel">Folder</sys:String>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#AEBBCD" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#F4F7FB" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#79AFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#202833" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <sys:String x:Key="BuildSteamFullLabel">Steam 빌드</sys:String>
        <sys:String x:Key="BuildStoveFullLabel">STOVE 빌드</sys:String>
        <sys:String x:Key="PackageBuildTooltip">Shipping 패키지를 생성하고 콘솔 창을 유지합니다.</sys:String>
        <sys:String x:Key="PackageBuildStartedStatus">패키징을 시작했습니다. 콘솔 창에서 진행 상황을 확인하세요.</sys:String>
        <sys:String x:Key="MovementCheatLabel">이동 치트 · 실행 중인 게임</sys:String>
        <sys:String x:Key="MovementCheatRefresh">게임 찾기</sys:String>
        <sys:String x:Key="MovementCheatSearching">실행 중인 게임을 찾는 중입니다…</sys:String>
        <sys:String x:Key="MovementCheatSearchFailed">게임 목록을 확인하지 못했습니다. 다시 찾아 주세요.</sys:String>
        <sys:String x:Key="MovementCheatEnable">이번 실행 활성화</sys:String>
        <sys:String x:Key="MovementCheatDisable">비활성화</sys:String>
        <sys:String x:Key="MovementCheatEnabled">선택한 프로세스의 이동 치트를 활성화했습니다.</sys:String>
        <sys:String x:Key="MovementCheatDisabled">선택한 프로세스의 이동 치트를 비활성화했습니다.</sys:String>
        <sys:String x:Key="MovementCheatNoTarget">호환되는 실행 중인 게임을 찾지 못했습니다.</sys:String>
        <sys:String x:Key="MovementCheatSelectTarget">게임 프로세스를 선택하세요.</sys:String>
        <sys:String x:Key="MovementCheatTargetSelected">게임 프로세스를 자동 선택했습니다. 활성화 또는 비활성화를 누르세요.</sys:String>
        <sys:String x:Key="MovementCheatFailed">프로세스에 접근하지 못했거나 치트 인터페이스가 호환되지 않습니다. 게임을 다시 찾은 뒤 시도하세요.</sys:String>
        <sys:String x:Key="MovementCheatStateEnabled">현재 상태 · 활성화</sys:String>
        <sys:String x:Key="MovementCheatStateDisabled">현재 상태 · 비활성화</sys:String>
        <sys:String x:Key="MovementCheatStateSelect">현재 상태 · 게임 선택 필요</sys:String>
        <sys:String x:Key="MovementCheatStateReading">현재 상태 · 확인 중</sys:String>
        <sys:String x:Key="MovementCheatStateUnknown">현재 상태 · 확인할 수 없음</sys:String>
        <sys:String x:Key="MovementCheatStateExited">현재 상태 · 선택한 게임 종료됨</sys:String>
        <sys:String x:Key="MovementCheatAutoOff">AUTO · 꺼짐</sys:String>
        <sys:String x:Key="MovementCheatAutoOn">AUTO · 켜짐</sys:String>
        <sys:String x:Key="MovementCheatAutoIdle">AUTO를 켜면 게임 실행을 감지해 치트를 활성화합니다.</sys:String>
        <sys:String x:Key="MovementCheatAutoWaiting">게임 실행 대기 중</sys:String>
        <sys:String x:Key="MovementCheatAutoSelect">게임이 여러 개입니다. 대상을 선택하세요.</sys:String>
        <sys:String x:Key="MovementCheatAutoActive">자동 활성화 유지 중 · 수동 해제해도 다시 활성화됩니다.</sys:String>
        <sys:String x:Key="MovementCheatAutoRetry">프로세스 접근 재시도 중</sys:String>
        <sys:String x:Key="MovementCheatAutoFailed">자동 감시를 중지했습니다. AUTO를 다시 켜세요.</sys:String>
        <sys:String x:Key="MovementCheatAutoTooltip">AUTO를 끄면 감시만 중지됩니다. 치트를 해제하려면 AUTO를 끈 뒤 비활성화를 누르세요.</sys:String>
        <sys:String x:Key="MovementCheatKeysTitle">사용키 · 이동 치트 활성화 후</sys:String>
        <sys:String x:Key="MovementCheatSpeedKey">F6 · 이동속도 1 → 3 → 8 → 1배 전환</sys:String>
        <sys:String x:Key="MovementCheatMapKey">M · 지도 열기</sys:String>
        <sys:String x:Key="MovementCheatTeleportKey">F9 · 지도의 기존 마커 위에 커서를 놓고 누르면 이동 확인</sys:String>
        <sys:String x:Key="MovementCheatCancelKey">Esc · 이동 확인창 취소</sys:String>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#273140" />
            <Setter Property="BorderBrush" Value="#3C4C61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#344257" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6B88AC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E2632" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#202833" />
            <Setter Property="Foreground" Value="#DCE5F0" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DCE5F0" />
            <Setter Property="Background" Value="#202833" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="설정">
                <MenuItem x:Name="RunAtStartupMenuItem"
                          Header="Windows 시작 시 실행"
                          IsCheckable="True"
                          Click="RunAtStartupMenuItem_Click" />
                <MenuItem x:Name="RegisterStartMenuMenuItem"
                          Header="시작 메뉴에 등록"
                          IsCheckable="True"
                          Click="RegisterStartMenuMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Grid Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl Background="Transparent" BorderThickness="0" SelectionChanged="HelperTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" />
                            <ContentPresenter Grid.Row="1" Margin="0,16,0,18"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem x:Name="MainTab" Header="{DynamicResource MainTabLabel}" IsSelected="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button Margin="0,0,0,10"
                                    Click="BuildAndRunButton_Click"
                                    ToolTip="TunaSweeper를 빌드하고 실행합니다.">
                                프로젝트 빌드 및 실행
                            </Button>
                            <Button x:Name="KillBuildButton" Margin="0,0,0,10"
                                    Background="#5A2630"
                                    BorderBrush="#82414D"
                                    Click="KillBuildButton_Click"
                                    Content="{DynamicResource ui.helper_packaging.stop_build}"
                                    ToolTip="{DynamicResource ui.helper_packaging.stop_build_tooltip}" />
                            <Button Margin="0,0,0,10"
                                    Background="#5A2630"
                                    BorderBrush="#82414D"
                                    Click="KillEditorButton_Click"
                                    ToolTip="실행 중인 TunaSweeper Unreal Editor를 종료합니다.">
                                Unreal Editor 종료
                            </Button>
                            <Button Margin="0,0,0,10"
                                    Click="OpenUnrealProjectButton_Click"
                                    ToolTip="TunaSweeper.uproject를 Unreal Editor로 엽니다.">
                                Unreal 프로젝트 열기
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="PackagingTab" Header="{DynamicResource ui.helper_packaging.tab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BuildSteamFullButton" Margin="0,0,5,0"
                                        Click="BuildSteamFullButton_Click"
                                        Content="{DynamicResource BuildSteamFullLabel}"
                                        ToolTip="{DynamicResource PackageBuildTooltip}" />
                                <Button x:Name="BuildStoveFullButton" Grid.Column="1"
                                        Margin="5,0,0,0"
                                        Click="BuildStoveFullButton_Click"
                                        Content="{DynamicResource BuildStoveFullLabel}"
                                        ToolTip="{DynamicResource PackageBuildTooltip}" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RunSteamFullButton" Grid.ColumnSpan="3" Margin="0,0,0,8"
                                        Click="RunSteamFullButton_Click" />
                                <TextBlock x:Name="SteamAppIdFileName" Grid.Row="1" Margin="8,0,0,0"
                                           Foreground="#F4F7FB" FontSize="15" VerticalAlignment="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" MinWidth="42"
                                        Background="#202833" BorderBrush="#3C4C61" BorderThickness="1" CornerRadius="4">
                                    <TextBlock x:Name="SteamAppIdIndicator" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="19" FontWeight="Bold" />
                                </Border>
                                <Button x:Name="SteamAppIdActionButton" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" MinWidth="80"
                                        Click="SteamAppIdActionButton_Click" />
                                <TextBlock x:Name="TrailerModeFileName" Grid.Row="2" Margin="8,6,0,0"
                                           Foreground="#F4F7FB" FontSize="15" VerticalAlignment="Center" />
                                <Border Grid.Row="2" Grid.Column="1" Margin="8,6,0,0" MinWidth="42"
                                        Background="#202833" BorderBrush="#3C4C61" BorderThickness="1" CornerRadius="4">
                                    <TextBlock x:Name="TrailerModeIndicator" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="19" FontWeight="Bold" />
                                </Border>
                                <Button x:Name="TrailerModeActionButton" Grid.Row="2" Grid.Column="2" Margin="8,6,0,0" MinWidth="80"
                                        Click="TrailerModeActionButton_Click" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="OpenSteamAchievementCommandsButton" Margin="0,0,4,0"
                                        Click="OpenSteamAchievementCommandsButton_Click" />
                                <Button x:Name="OpenSteamConsoleButton" Grid.Column="1" Margin="4,0,0,0"
                                        Click="OpenSteamConsoleButton_Click" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="OpenSteamUploadScriptsFolderButton" Margin="0,0,4,0"
                                        Click="OpenSteamUploadScriptsFolderButton_Click" />
                                <Button x:Name="RunSteamUploadButton" Grid.Column="1" Margin="4,0,0,0"
                                        Click="RunSteamUploadButton_Click" />
                            </Grid>
                            <Button x:Name="KillPackagingButton" Margin="0,0,0,10"
                                    Background="#5A2630"
                                    BorderBrush="#82414D"
                                    Click="KillPackagingButton_Click"
                                    Content="{DynamicResource ui.helper_packaging.stop_package}"
                                    ToolTip="{DynamicResource ui.helper_packaging.stop_package_tooltip}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="CheatTab" Header="{DynamicResource CheatTabLabel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" Foreground="#DCE5F0" Text="{DynamicResource MovementCheatLabel}" />
                        <ComboBox x:Name="MovementCheatTargets" MinHeight="30" Margin="0,0,0,8" SelectionChanged="MovementCheatTargets_SelectionChanged" />
                        <TextBlock x:Name="MovementCheatStateText" Margin="0,0,0,8" Foreground="#F4F7FB" FontSize="15" TextWrapping="Wrap" Text="{DynamicResource MovementCheatStateSelect}" />
                        <Button MinHeight="40" x:Name="MovementCheatRefreshButton" Margin="0,0,0,8" Click="RefreshMovementCheatTargets_Click" Content="{DynamicResource MovementCheatRefresh}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button MinHeight="40" Margin="0,0,5,0" Click="EnableMovementCheat_Click" Content="{DynamicResource MovementCheatEnable}" />
                            <Button MinHeight="40" Grid.Column="1" Margin="5,0,0,0" Click="DisableMovementCheat_Click" Content="{DynamicResource MovementCheatDisable}" />
                        </Grid>
                        <Button MinHeight="40" x:Name="MovementCheatAutoButton" Margin="0,8,0,6" Click="ToggleMovementCheatAuto_Click" Content="{DynamicResource MovementCheatAutoOff}" ToolTip="{DynamicResource MovementCheatAutoTooltip}" />
                        <TextBlock x:Name="MovementCheatAutoStatus" Foreground="#AEBBCD" TextWrapping="Wrap" Text="{DynamicResource MovementCheatAutoIdle}" />
                        <Button MinHeight="40" Margin="0,8,0,0" Click="OpenWorldProgress_Click" Content="{DynamicResource WorldProgressOpen}" />
                        <Button MinHeight="40" x:Name="TunaFillButton" Margin="0,8,0,0" Click="FillTuna_Click" Content="{DynamicResource TunaFillButton}" />
                        <Button MinHeight="40" Margin="0,8,0,0" Click="OpenItemGrant_Click" Content="{DynamicResource ui.item_grant.title}" />
                        <Border Margin="0,8,0,0" Padding="10" Background="#202833" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Foreground="#DCE5F0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{DynamicResource MovementCheatKeysTitle}" />
                                <TextBlock Margin="0,0,0,6" Foreground="#AEBBCD" TextWrapping="Wrap" Text="{DynamicResource MovementCheatSpeedKey}" />
                                <TextBlock Margin="0,0,0,6" Foreground="#AEBBCD" TextWrapping="Wrap" Text="{DynamicResource MovementCheatMapKey}" />
                                <TextBlock Margin="0,0,0,6" Foreground="#AEBBCD" TextWrapping="Wrap" Text="{DynamicResource MovementCheatTeleportKey}" />
                                <TextBlock Foreground="#AEBBCD" TextWrapping="Wrap" Text="{DynamicResource MovementCheatCancelKey}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="FolderTab" Header="{DynamicResource FolderTabLabel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button Margin="0,0,0,10"
                                    Click="OpenProjectFolderButton_Click"
                                    ToolTip="TunaSweeper 프로젝트 폴더를 탐색기로 엽니다.">
                                Unreal 프로젝트 폴더 열기
                            </Button>
                            <Button x:Name="OpenSteamLauncherFolderButton" Margin="0,0,0,10"
                                    Click="OpenSteamLauncherFolderButton_Click" />
                            <Button x:Name="OpenSteamAppIdFolderButton" Margin="0,0,0,10"
                                    Click="OpenSteamAppIdFolderButton_Click" />
                            <Button Margin="0,0,0,10"
                                    Click="OpenFfmpegFolderButton_Click"
                                    ToolTip="D:\github\ffmpeg 폴더를 탐색기로 엽니다.">
                                FFmpeg 폴더 열기
                            </Button>
                            <Button Click="OpenDownloadsFolderButton_Click"
                                    ToolTip="다운로드 폴더를 탐색기로 엽니다.">
                                다운로드 폴더 열기
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="1"
                       Foreground="#91A5BE"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="{DynamicResource ReadyStatus}" />
        </Grid>
    </DockPanel>
</Window>
