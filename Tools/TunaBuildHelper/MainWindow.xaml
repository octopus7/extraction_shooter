<Window x:Class="TunaBuildHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tuna Build Helper"
        Width="124"
        Height="56"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        MouseMove="Window_MouseMove"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#20252c" />
        <SolidColorBrush x:Key="BorderBrush" Color="#596273" />
        <SolidColorBrush x:Key="BorderHoverBrush" Color="#8d97a8" />
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderBrush" Value="#435061" />
            <Setter Property="Background" Value="#252c35" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="48" Height="48">
                            <Ellipse x:Name="Root"
                                     Width="42"
                                     Height="42"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="2" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Fill" Value="#303a46" />
                                <Setter TargetName="Root" Property="Stroke" Value="#6c7b90" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Fill" Value="#1a2028" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Width="124" Height="56">
        <Border x:Name="ChromeBorder"
                Width="104"
                Height="56"
                HorizontalAlignment="Left"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="4"
                Background="{StaticResource PanelBrush}"
                MouseLeftButtonDown="ChromeBorder_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource IconButtonStyle}"
                        Click="KillButton_Click"
                        ToolTip="Kill TunaSweeper editor">
                    <Viewbox Width="31" Height="31" Stretch="Uniform">
                        <Canvas Width="48" Height="48">
                            <Path Fill="#dc3347"
                                  Stroke="#ff8792"
                                  StrokeThickness="2"
                                  Data="M15,4 L33,4 L44,15 L44,33 L33,44 L15,44 L4,33 L4,15 Z" />
                            <Rectangle Canvas.Left="15"
                                       Canvas.Top="16"
                                       Width="18"
                                       Height="14"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Fill="#15191f"
                                       Stroke="#242b33"
                                       StrokeThickness="1" />
                            <Rectangle Canvas.Left="18"
                                       Canvas.Top="19"
                                       Width="12"
                                       Height="3"
                                       Fill="#69788a" />
                            <Path Stroke="#ffffff"
                                  StrokeThickness="4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M17,34 L31,20 M31,34 L17,20" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Click="BuildButton_Click"
                        ToolTip="Build and run TunaSweeper">
                    <Viewbox Width="31" Height="31" Stretch="Uniform">
                        <Canvas Width="48" Height="48">
                            <Path Fill="#1f8f6b"
                                  Stroke="#67d2ad"
                                  StrokeThickness="2"
                                  Data="M10,34 L27,17 L32,22 L15,39 Z" />
                            <Rectangle Canvas.Left="29"
                                       Canvas.Top="8"
                                       Width="7"
                                       Height="23"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Fill="#dde7ef"
                                       Stroke="#7c8796"
                                       StrokeThickness="1"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="-45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Path Fill="#f0b84a"
                                  Stroke="#ffd98a"
                                  StrokeThickness="2"
                                  Data="M29,6 L42,19 L36,25 L23,12 Z" />
                            <Path Stroke="#12231d"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M13,35 L21,27 M26,20 L33,13" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <Button x:Name="CloseButton"
                Width="22"
                Height="22"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="96,4,0,0"
                Padding="0"
                BorderThickness="1"
                BorderBrush="#ff9ca6"
                Background="#cc1f35"
                Foreground="White"
                FontSize="12"
                FontWeight="Bold"
                Cursor="Hand"
                Focusable="False"
                Visibility="Collapsed"
                Click="CloseButton_Click"
                MouseEnter="CloseButton_MouseEnter"
                MouseLeave="CloseButton_MouseLeave"
                ToolTip="Close">X</Button>
    </Grid>
</Window>
