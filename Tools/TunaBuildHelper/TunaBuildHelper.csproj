<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TunaBuildHelper</AssemblyName>
    <ApplicationIcon>BabyBoar.ico</ApplicationIcon>
    <RootNamespace>TunaBuildHelper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TunaBuildHelper.Tests" />
    <Resource Include="BabyBoar.ico" />
    <EmbeddedResource Include="../../TunaSweeper/Content/Data/UITextStrings.csv" LogicalName="UITextStrings.csv" />
    <EmbeddedResource Include="../../TunaSweeper/Content/Data/ItemNameStrings.csv" LogicalName="ItemNameStrings.csv" />
    <EmbeddedResource Include="../../TunaSweeper/Content/Data/ItemTable.json" LogicalName="ItemTable.json" />
  </ItemGroup>
</Project>
