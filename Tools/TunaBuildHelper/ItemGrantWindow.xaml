<Window x:Class="TunaBuildHelper.ItemGrantWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource ui.item_grant.title}" Width="850" Height="620" MinWidth="700" MinHeight="440"
 Background="#171B22" Foreground="#DCE5F0" WindowStartupLocation="CenterOwner">
 <Grid Margin="24">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="TargetText" Foreground="#91A5BE" TextWrapping="Wrap"/>
    <TextBlock Margin="0,12,0,16" Text="{DynamicResource ui.helper_item_grant.scope}" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource ui.item_grant.id}"/>
    <TextBox x:Name="ItemIdBox" Text="6019" Margin="0,6,0,6" FontSize="18" TextChanged="InputChanged"/>
    <TextBlock x:Name="ItemNameText" Margin="0,0,0,16" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource ui.item_grant.quantity}"/>
    <TextBox x:Name="QuantityBox" Text="1" Margin="0,6,0,16" FontSize="18" TextChanged="InputChanged"/>
    <Button x:Name="GrantButton" Content="{DynamicResource ui.item_grant.grant}" Click="Grant_Click" IsEnabled="False"/>
    <TextBlock x:Name="StatusText" Margin="0,16,0,0" Foreground="#91A5BE" TextWrapping="Wrap"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="{DynamicResource ui.item_grant.picker}" FontSize="17" Margin="0,0,0,12"/>
   <ListBox x:Name="FeaturedList" Grid.Row="1" Background="#202833" Foreground="#DCE5F0" BorderBrush="#3C4C61"
    ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Featured_SelectionChanged">
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="6,8"/></DataTemplate></ListBox.ItemTemplate>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
   </ListBox>
  </Grid>
 </Grid>
</Window>
