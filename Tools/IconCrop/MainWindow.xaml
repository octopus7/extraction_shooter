<Window x:Class="IconCropTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Icon Crop Tool"
        Width="1500"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        Background="#111418">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#d7dde8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,0,8,0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinWidth" Value="62" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Load JSON" Click="LoadJson_Click" />
                    <Button Content="Save JSON" Click="SaveJson_Click" />
                    <Button Content="Run Crop" Click="RunCrop_Click" />
                    <CheckBox x:Name="SharedModeCheckBox"
                              Content="Row/Column shared"
                              Foreground="#d7dde8"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="8,0,16,0" />
                    <TextBlock Text="Zoom"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0" />
                    <Slider x:Name="ZoomSlider"
                            Width="150"
                            Minimum="0.25"
                            Maximum="2.5"
                            Value="0.75"
                            TickFrequency="0.25"
                            IsSnapToTickEnabled="False"
                            ValueChanged="ZoomSlider_ValueChanged" />
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="#99a6b8"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,10,0,0">
                <TextBlock Text="Output"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0" />
                <Button Content="Use JSON Folder"
                        DockPanel.Dock="Left"
                        Click="UseJsonFolderForOutput_Click" />
                <Button Content="Choose Output"
                        DockPanel.Dock="Left"
                        Click="ChooseOutput_Click" />
                <TextBlock x:Name="OutputInfoText"
                           Foreground="#8792a3"
                           VerticalAlignment="Center"
                           Text="JSON folder" />
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <TextBlock Text="Source Sheet"
                               FontSize="15"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left" />
                    <TextBlock x:Name="SheetInfoText"
                               TextAlignment="Right"
                               Foreground="#8792a3" />
                </DockPanel>

                <Border Grid.Row="1"
                        Background="#050607"
                        BorderBrush="#303846"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ScrollViewer x:Name="SheetScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="SheetHost"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                            <Image x:Name="SheetImage"
                                   Stretch="Fill"
                                   SnapsToDevicePixels="True" />
                            <Canvas x:Name="OverlayCanvas"
                                    Background="Transparent"
                                    MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown" />
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,10,0,0"
                        Background="#171c22"
                        BorderBrush="#303846"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Selected"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="X" VerticalAlignment="Center" Foreground="#9aa6b8" />
                            <TextBox x:Name="CropXText" LostFocus="CropField_LostFocus" KeyDown="CropField_KeyDown" />
                            <TextBlock Text="Y" VerticalAlignment="Center" Foreground="#9aa6b8" />
                            <TextBox x:Name="CropYText" LostFocus="CropField_LostFocus" KeyDown="CropField_KeyDown" />
                            <TextBlock Text="W" VerticalAlignment="Center" Foreground="#9aa6b8" />
                            <TextBox x:Name="CropWidthText" LostFocus="CropField_LostFocus" KeyDown="CropField_KeyDown" />
                            <TextBlock Text="H" VerticalAlignment="Center" Foreground="#9aa6b8" />
                            <TextBox x:Name="CropHeightText" LostFocus="CropField_LostFocus" KeyDown="CropField_KeyDown" />
                            <Button Content="Apply" Click="ApplyCropFields_Click" Margin="4,0,0,0" />
                            <Button Content="Auto Trim" Click="AutoTrimSelected_Click" Margin="8,0,0,0" />
                            <Button Content="Trim All" Click="AutoTrimAll_Click" />
                            <TextBlock Text="Alpha"
                                       VerticalAlignment="Center"
                                       Foreground="#9aa6b8"
                                       Margin="4,0,0,0" />
                            <TextBox x:Name="AlphaThresholdText"
                                     Text="8"
                                     MinWidth="44"
                                     Width="48" />
                            <TextBlock Text="Mode"
                                       VerticalAlignment="Center"
                                       Foreground="#9aa6b8"
                                       Margin="4,0,0,0" />
                            <ComboBox x:Name="AutoTrimModeComboBox"
                                      SelectedIndex="0"
                                      Width="170"
                                      Margin="4,0,0,0"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="1 Center clean" />
                                <ComboBoxItem Content="2 Edge recover" />
                                <ComboBoxItem Content="3 Edge off" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="SelectedInfoText"
                                   TextAlignment="Right"
                                   Foreground="#8792a3"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="#222933" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <TextBlock Text="Cropped Icons"
                               FontSize="15"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left" />
                    <TextBlock x:Name="PreviewInfoText"
                               TextAlignment="Right"
                               Foreground="#8792a3" />
                </DockPanel>
                <Border Grid.Row="1"
                        Background="#171c22"
                        BorderBrush="#303846"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IconGrid"
                                      ItemsSource="{Binding IconPreviews}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="128"
                                            Height="152"
                                            Margin="6"
                                            Padding="7"
                                            Background="{Binding BackgroundBrush}"
                                            BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            MouseLeftButtonDown="IconPreview_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="104" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="#0b0d10"
                                                    BorderBrush="#2a3340"
                                                    BorderThickness="1">
                                                <Image Source="{Binding Preview}"
                                                       Width="96"
                                                       Height="96"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Label}"
                                                       Foreground="#d7dde8"
                                                       FontSize="11"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,7,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   Foreground="#8792a3"
                   TextWrapping="Wrap"
                   Text="Drag a rectangle on the source sheet to move its crop. Drag the selected rectangle's lower-right handle to resize. Shared mode applies X/Width to the same column and Y/Height to the same row; auto trim disables shared mode before applying transparent-area bounds." />
    </Grid>
</Window>
