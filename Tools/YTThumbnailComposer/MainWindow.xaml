<Window x:Class="YTThumbnailComposer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YT Thumbnail Composer"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        Background="#15171b">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Background"
                           VerticalAlignment="Center"
                           Foreground="#d7dde8"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="BackgroundSelector"
                          Width="220"
                          DisplayMemberPath="Label"
                          SelectionChanged="BackgroundSelector_SelectionChanged" />
                <TextBlock Text="Number"
                           VerticalAlignment="Center"
                           Foreground="#d7dde8"
                           FontWeight="SemiBold"
                           Margin="12,0,8,0" />
                <TextBox x:Name="EpisodeNumberText"
                         Width="70"
                         TextChanged="EpisodeNumberText_TextChanged" />
                <Button Content="Render Selected"
                        Click="RenderSelected_Click"
                        Margin="12,0,0,0"
                        Padding="14,6" />
                <Button Content="Render All"
                        Click="RenderAll_Click"
                        Margin="8,0,0,0"
                        Padding="14,6" />
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="#9aa6b8" />
        </DockPanel>

        <Border Grid.Row="1"
                Background="#050607"
                BorderBrush="#303846"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
            <Viewbox Stretch="Uniform">
                <Border Width="1280" Height="720" Background="Black">
                    <Image x:Name="PreviewImage"
                           Width="1280"
                           Height="720"
                           Stretch="Fill" />
                </Border>
            </Viewbox>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#8792a3"
                   TextWrapping="Wrap"
                   Text="Uses original BG_A/B/C crops plus generated white masks for the paint backing, Devlog#, and 0-9 digits. Colors, shadows, placement, and number compositing are rendered by code." />
    </Grid>
</Window>
